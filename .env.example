# Local development only. Render needs only GEMINI_API_KEY, GOOGLE_APPLICATION_CREDENTIALS, DATABASE_URL.
# Copy to private/local.env. Never commit credentials or roster files.
APP_MODE=local
PORT=8765
DATABASE_URL=sqlite:///private/turtlesoup.db
ROSTER_MODE=file
ROSTER_PATH=private/roster.json
PUZZLES_PATH=private/puzzles.json
AI_MODE=mock
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=1024
GOOGLE_SHEET_ID=1CdLxYuVMC_YJ0hSRWoieaklwLJEdZHsi7MHVq-xyyOU
GOOGLE_ROSTER_GID=0
GOOGLE_APPLICATION_CREDENTIALS=private/google-service-account.json
SHEETS_SYNC_ENABLED=false
ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
SESSION_SECONDS=7200
SYNC_SECONDS=30
